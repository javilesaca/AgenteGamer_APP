<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de extracción de datos (API 31+). La DB Room con datos
     financieros no sale del dispositivo ni a cloud ni en transferencia. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
